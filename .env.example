# ProDesk configuration. Copy to `.env` (local) or `.env.production` (prod) and fill in.
# NEVER commit real values. Every secret below is intentionally blank.

# --- Core -----------------------------------------------------------------------------
# development | staging | production
APP_ENV=development
LOG_LEVEL=INFO
LOG_JSON=true
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Fernet key for encrypting per-firm integration secrets.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

DATABASE_URL=postgresql+psycopg://prodesk:prodesk@localhost:5432/prodesk
REDIS_URL=redis://localhost:6379/0

FRONTEND_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
# true in production (HTTPS)
REFRESH_COOKIE_SECURE=false

ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
CLIENT_SESSION_TTL_MINUTES=60
SIGNED_URL_TTL_SECONDS=300
DELIVERY_LINK_TTL_HOURS=72
OTP_TTL_SECONDS=300
MAX_UPLOAD_MB=25
RATE_LIMIT_ENABLED=true
# WhatsApp simulator + mock checkout; always off in production
ENABLE_DEV_TOOLS=true

# --- Storage --------------------------------------------------------------------------
# local | s3
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./storage
S3_BUCKET=
S3_REGION=ap-south-1
# only for S3-compatible stores (e.g. MinIO)
S3_ENDPOINT_URL=
# optional SSE-KMS key; SSE-S3 (AES256) otherwise
S3_KMS_KEY_ID=
# AWS credentials come from the standard chain (IAM role recommended):
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY=

# --- WhatsApp (official Meta WhatsApp Cloud API only) ----------------------------------
# mock | meta
WHATSAPP_PROVIDER=mock
# default/system-user token (per-firm tokens can be set in Settings)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# any random string; also entered in Meta webhook config
WHATSAPP_VERIFY_TOKEN=
# Meta app secret: validates X-Hub-Signature-256
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_SEND_RATE_PER_MINUTE=60

# --- AI -------------------------------------------------------------------------------
# mock | openai
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Payments -------------------------------------------------------------------------
# mock | razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_PAYMENT_SECRET=local-mock-gateway-secret

# --- Email ----------------------------------------------------------------------------
# console | smtp
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ProDesk <no-reply@example.com>
SMTP_USE_TLS=true

# --- Workers --------------------------------------------------------------------------
CELERY_TASK_ALWAYS_EAGER=false
